# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...                 # for frontend (Vite reads VITE_*)
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # backend only — never expose

# --- LLM (Tailnet, OpenAI-compatible) -------------------------------------
LOCAL_BASE_URL=http://100.122.52.86:1234/v1
LOCAL_MODEL=google/gemma-4-e2b
LOCAL_API_KEY=lm-studio                  # LM Studio accepts any value

# --- Embeddings (same Tailnet host, different model) ----------------------
EMBEDDING_BASE_URL=http://100.122.52.86:1234/v1
EMBEDDING_MODEL=bge-m3                   # or your loaded embed model
EMBEDDING_API_KEY=lm-studio

# --- OpenAI (TTS-1 only — STT is now local Whisper) -----------------------
OPENAI_API_KEY=                          # blank disables TTS; STT works without it

# --- Tavily (web search for the agent) ------------------------------------
# Free tier: 1000 calls/month. Sign up at https://app.tavily.com/
TAVILY_API_KEY=                          # blank disables [search:] markers

# --- Local Whisper (faster-whisper, GPU-first) ----------------------------
# Defaults match the user's working transcription_service setup.
# Cache: <project root>/.whisper-models/    Recordings: <project root>/recordings/
WHISPER_MODEL=large-v3                   # large-v3 | large-v3-turbo | medium | small | ...
WHISPER_DEVICE=cuda                      # cuda | cpu | auto
WHISPER_COMPUTE=float16                  # float16 | int8_float16 | float32 | default
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_VAD_MIN_SILENCE_MS=500

# --- Web Push (VAPID) -----------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com

# --- Google Calendar (OAuth via Supabase provider) ------------------------
ENABLE_CALENDAR=false
CALENDAR_ENCRYPTION_KEY=                 # 32-byte base64; generate with scripts/generate_keys.py

# --- Server ---------------------------------------------------------------
PORT=8000
ENV=development                          # development | staging | production
ALLOWED_ORIGINS=http://localhost:5173

# --- Feature flags --------------------------------------------------------
ENABLE_RAG=true
ENABLE_REMINDERS=false
ENABLE_PLANNING_FLOW=true

# --- Frontend (Vite) ------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_VAPID_PUBLIC_KEY=
