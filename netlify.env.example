# =====================================================================
# Netlify env variables — copy each line into:
#   Netlify dashboard → Site settings → Environment variables
#
# These are the ONLY vars Netlify needs. Do NOT add backend keys
# (service-role, OpenAI, NVIDIA, VAPID private, encryption) here —
# they would be useless and a security risk.
# =====================================================================

# Where the FastAPI backend is reachable from a public browser.
# - For demo via your laptop:   tailscale funnel --bg 8000
#   then paste the https://*.ts.net URL it prints below.
# - Must be HTTPS (Netlify pages are HTTPS; mixed content is blocked).
# - Do NOT use http://100.122.52.86:8000 — phones outside your Tailnet
#   can't reach it, and Netlify-hosted https pages can't call http URLs.
VITE_API_BASE_URL=https://your-machine.your-tailnet.ts.net

# --- Supabase (these are intentionally public; RLS protects data) ----
VITE_SUPABASE_URL=https://mkqosrewgpotftbhqxfs.supabase.co
