# --- Dev bypass (skip MagicLink for the demo) ------------------------
# Set to 'true' for the no-login MVP demo. Backend must also have
# DEV_USER_ID set (in YOUR LOCAL .env, not Netlify) for FKs to resolve.
# Remove or set to 'false' once real auth is wired.
VITE_DEV_BYPASS=true
